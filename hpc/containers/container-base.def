Bootstrap: docker
From: ubuntu:22.04

%help
  SfSpp Base Dependencies Container
  – provides optimized scientific computing environment
  – pre-built PCL, CGAL, Ceres dependencies
  – suitable for HPC deployment

%labels
  Author    Structure from Sherds++ Team
  Version   2.0.0
  Stage     base-dependencies

%environment
  export DEBIAN_FRONTEND=noninteractive
  export TZ=UTC
  export NPROC=$(grep -c ^processor /proc/cpuinfo 2>/dev/null || echo 4)
  export MAKEFLAGS="-j${NPROC} -l${NPROC}"
  export CMAKE_BUILD_PARALLEL_LEVEL=${NPROC}

%post
  # Stage 1: System packages and lightweight dependencies
  echo "[STAGE 1] Installing system packages..."
  export DEBIAN_FRONTEND=noninteractive
  export TZ=UTC
  
  apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential cmake git wget unzip curl \
    pkg-config software-properties-common \
    libeigen3-dev libboost-all-dev \
    libopenblas-dev liblapack-dev gfortran \
    libgoogle-glog-dev libgflags-dev \
    libglew-dev freeglut3-dev \
    libusb-1.0-0-dev \
    python3-dev python3-pip \
    && rm -rf /var/lib/apt/lists/*

  # Stage 2: Pre-built scientific libraries from Ubuntu repos (faster)
  echo "[STAGE 2] Installing pre-built scientific libraries..."
  apt-get update -qq && apt-get install -y --no-install-recommends \
    libvtk9-dev \
    libpcl-dev \
    libcgal-dev \
    libceres-dev \
    libflann-dev \
    libqhull-dev \
    libsuitesparse-dev \
    && rm -rf /var/lib/apt/lists/*

  # Stage 3: Create optimized build environment
  echo "[STAGE 3] Setting up build environment..."
  mkdir -p /opt/sfs/bin /opt/sfs/lib /opt/sfs/include /opt/sfs/share
  
  # Create build configuration
  cat > /opt/sfs/share/build-config.cmake << 'EOF'
# Optimized build configuration for SfS preprocessing
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_BUILD_TYPE Release)
set(CMAKE_CXX_FLAGS_RELEASE "-O2 -DNDEBUG -march=native")
set(CMAKE_INSTALL_PREFIX /opt/sfs)

# Use system libraries to avoid compilation overhead
find_package(PkgConfig REQUIRED)
find_package(PCL 1.10 REQUIRED COMPONENTS common io features surface)
find_package(CGAL REQUIRED)
find_package(Ceres REQUIRED)
find_package(VTK REQUIRED)
find_package(Boost REQUIRED COMPONENTS system filesystem thread)
find_package(Eigen3 REQUIRED)
EOF

%test
  # Verify all dependencies are properly installed
  echo "Testing dependency availability..."
  pkg-config --exists eigen3 && echo "✓ Eigen3 found"
  pkg-config --exists opencv4 || echo "ℹ OpenCV optional"
  ldconfig -p | grep -q libpcl && echo "✓ PCL libraries found"
  ldconfig -p | grep -q libCGAL && echo "✓ CGAL libraries found"
  ldconfig -p | grep -q libceres && echo "✓ Ceres libraries found"
  ldconfig -p | grep -q libvtk && echo "✓ VTK libraries found"
  echo "Base dependency container ready ✓"