+// Ticket 326. Every length gate on the matching path is a multiple of one scale
+// measured from the object itself: the median breakline bounding-box diagonal
+// of the pieces the assembler loaded, in mm. Gate(legacy) = legacy * scale / 60.
+// The 60 mm reference is the size the literals were written for: pot F's median
+// piece diagonal is 61 mm, the smallest of the ten scored pots, so on every
+// scored pot the gate is at or above the legacy one (1.02x on F to 2.52x on C).
+extern double g_len_scale;
+void MeasureLengthScale(const vector<Geom>& shard);
+inline double Gate(double legacy_mm)
+{
+	return legacy_mm * (g_len_scale > 0 ? g_len_scale / 60.0 : 1.0);
+}
+
+#endif // !_DATA_STRUCTURE_H_
