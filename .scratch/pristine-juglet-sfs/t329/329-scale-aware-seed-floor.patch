+// Ticket 329: scale-aware seed floor. MINIMUM_NUMBER (6) was written for pots whose
+// median piece breakline bounding-box diagonal is about 60 mm. One scale is measured
+// from the object itself (median breakline bounding-box diagonal of the loaded
+// matching pieces, in mm -- measurement reused verbatim from ticket 326), then
+// s_raw = len_scale_mm/60, s = min(1, s_raw), M = max(3, (int)ceil(6.0*s)).
+// Every former MINIMUM_NUMBER consumer reads M (M/2 at the half floors).
+// The macro stays as the written-for-60mm constant; nothing else changes.
+extern double g_len_scale;
+void MeasureLengthScale(const vector<Geom>& shard);
+int MinNumFloor();
+
 #endif // !_DATA_STRUCTURE_H_
