\ No newline at end of file
+}
+double g_len_scale = 0;
+
+// Ticket 326 measurement, reused verbatim: the median breakline bounding-box
+// diagonal of the matching pieces, in mm. The 60 mm reference is the size the
+// literals were written for (pot F, the smallest scored pot, is 61 mm).
+void MeasureLengthScale(const vector<Geom>& shard)
+{
+	if (g_len_scale > 0)
+		return;
+	vector<double> diag;
+	for (int i = 0; i < (int)shard.size(); i++) {
+		if (!shard[i].is_matching_)
+			continue;
+		const MatrixXd& p = shard[i].edge_line_.point_;
+		if (p.cols() < 2)
+			continue;
+		Vector3d mn = p.rowwise().minCoeff();
+		Vector3d mx = p.rowwise().maxCoeff();
+		diag.push_back((mx - mn).norm());
+	}
+	if (diag.empty()) {
+		g_len_scale = 60.0;
+		cout << "SCALE329 v1 len_scale_mm=60 n=0 s_raw=1.000 s=1.000 M=6 ref_mm=60 FALLBACK" << endl;
+		return;
+	}
+	sort(diag.begin(), diag.end());
+	g_len_scale = diag[diag.size() / 2];
+	{
+		double s_raw = g_len_scale / 60.0;
+		double s = min(1.0, s_raw);
+		int M = max(3, (int)ceil(6.0 * s));
+		cout << "SCALE329 v1 len_scale_mm=" << g_len_scale
+			<< " n=" << diag.size()
+			<< " s_raw=" << fixed << setprecision(3) << s_raw
+			<< " s=" << s
+			<< " M=" << M
+			<< " ref_mm=60" << endl;
+	}
+}
+
+// Ticket 329 pre-registered formula (fixed shape, single knob): the seed floor.
+// Unmeasured (g_len_scale == 0) behaves as 60 mm, i.e. M = 6 = pristine.
+int MinNumFloor()
+{
+	double s_raw = (g_len_scale > 0 ? g_len_scale / 60.0 : 1.0);
+	double s = min(1.0, s_raw);
+	return max(3, (int)ceil(6.0 * s));
+}
